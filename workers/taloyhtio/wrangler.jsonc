{
  // As Oy Koivurinne (simulated housing company): static site + default-model proxy.
  // Same Worker code as Charge (../charge/src). Deploy from this folder:
  //   npx wrangler deploy        Secret (once): npx wrangler secret put SESSION_SECRET
  "name": "taloyhtio",
  "main": "../charge/src/index.js",
  // Max date supported by the local Wrangler (4.86) is 2026-05-03.
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "../../sites/taloyhtio",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "ai": { "binding": "AI" },
  // Arbiter (M5a): requests, scheduled nights, append-only receipts, admissions. EU (weur).
  //   npx wrangler d1 migrations apply taloyhtio-arbiter --remote
  "d1_databases": [
    { "binding": "ARBITER_DB", "database_name": "taloyhtio-arbiter", "database_id": "3356ddcb-52b2-40eb-8028-a08cdf99b651", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "SESSION_LIMIT", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LLM_LIMIT", "namespace_id": "3002", "simple": { "limit": 30, "period": 60 } },
    { "name": "LLM_IP_LIMIT", "namespace_id": "3003", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
