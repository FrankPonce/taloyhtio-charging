{
  // Charge site: static site + default-model proxy. Deploy from this folder:
  //   npx wrangler deploy
  // Secret (once): npx wrangler secret put SESSION_SECRET
  "name": "charge",
  "main": "src/index.js",
  // Max date supported by the local Wrangler (4.86) is 2026-05-03.
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "../../sites/charge",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "SESSION_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LLM_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "LLM_IP_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
